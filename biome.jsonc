{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/migrations/meta",
      "!**/dist",
      "!**/.output",
      "!!**/node_modules",
      "!!**/.git"
    ]
  },
  "formatter": {
    "enabled": true,
    "expand": "auto",
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use an alias instead: @/... in apps, @repo/<pkg>/... in packages."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/frontend/**"],
      "linter": { "domains": { "react": "recommended" } }
    }
  ],

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "preset": "recommended",
        "useSortedAttributes": "on",
        "useSortedKeys": "off",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "assist": { "enabled": true },
    "formatter": { "enabled": true, "indentStyle": "space" },
    "linter": { "enabled": true },
    "parser": {
      "allowWrongLineComments": false,
      "cssModules": true,
      "tailwindDirectives": true
    }
  },

  "html": {
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "indentStyle": "space"
    }
  },
  "javascript": {
    "assist": { "enabled": true },
    "formatter": {
      "arrowParentheses": "always",
      "enabled": true,
      "indentStyle": "space",
      "lineEnding": "lf",
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "jsxEverywhere": false
    }
  },
  "json": {
    "assist": { "enabled": true },
    "formatter": { "enabled": true, "expand": "auto", "indentStyle": "space" },
    "linter": { "enabled": true }
  }
}
